{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "kompitu.rw3kotabaru.site"
        }
      ],
      "destination": "/kompitu/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kompitu.rw3kotabaru.site"
        }
      ],
      "destination": "/kompitu/:path*"
    }
  ]
}
