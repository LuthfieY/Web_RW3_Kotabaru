---
import { ArrowLeft, Clock3, MapPin, MessageCircle, ShieldAlert } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { UMKM } from "../../data/umkm";

export function getStaticPaths() {
  return UMKM.map((umkm) => ({ params: { slug: umkm.slug }, props: { umkm } }));
}

const { umkm } = Astro.props;
---

<BaseLayout title={umkm.name} description={umkm.description} image={umkm.photo}>
  <section class="texture-paper border-b border-rw-line"><div class="container-shell section-space pb-10"><a href="/umkm" class="inline-flex items-center gap-2 text-sm font-bold text-rw-terracotta-dark hover:text-rw-forest"><ArrowLeft size={17} aria-hidden="true" />Kembali ke direktori</a><div class="mt-8 grid items-end gap-8 lg:grid-cols-[1fr_auto]"><div><p class="eyebrow">{umkm.category}</p><h1 class="mt-4 font-display text-4xl font-bold leading-tight text-rw-forest sm:text-6xl">{umkm.name}</h1><p class="mt-5 max-w-2xl text-base leading-8 text-rw-muted">{umkm.description}</p></div><span class="inline-flex items-center gap-2 rounded-full bg-rw-terracotta/10 px-4 py-2 text-xs font-bold text-rw-terracotta-dark"><ShieldAlert size={15} aria-hidden="true" />Data menunggu verifikasi</span></div></div></section>
  <section class="section-space"><div class="container-shell grid gap-10 lg:grid-cols-[1.05fr_0.95fr]"><div class="overflow-hidden rounded-xl border-8 border-white shadow-[0_20px_50px_rgba(27,67,50,0.12)]"><img src={umkm.photo} alt={umkm.name} class="aspect-[4/3] w-full object-cover" /></div><div><div class="space-y-5 border-y border-rw-line py-6">{umkm.address && <p class="flex items-start gap-3 text-sm leading-6 text-rw-muted"><MapPin class="mt-0.5 shrink-0 text-rw-terracotta" size={19} aria-hidden="true" />{umkm.address}</p>}{umkm.openingHours && <p class="flex items-start gap-3 text-sm leading-6 text-rw-muted"><Clock3 class="mt-0.5 shrink-0 text-rw-terracotta" size={19} aria-hidden="true" />{umkm.openingHours}</p>}{umkm.status === "verified" && umkm.whatsapp && <a href={`https://wa.me/${umkm.whatsapp}`} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 rounded-full bg-[#168c4b] px-5 py-3 text-sm font-bold text-white"><MessageCircle size={17} aria-hidden="true" />Hubungi via WhatsApp</a>}</div>{umkm.note && <p class="mt-6 border-l-4 border-rw-terracotta bg-rw-terracotta/8 p-4 text-sm leading-6 text-rw-terracotta-dark"><strong>Catatan:</strong> {umkm.note}</p>}<p class="mt-6 text-sm leading-7 text-rw-muted">Detail kontak dan jam buka hanya akan ditampilkan setelah mendapat persetujuan pemilik usaha.</p></div></div></section>
</BaseLayout>
