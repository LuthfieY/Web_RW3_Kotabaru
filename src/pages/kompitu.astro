---
import { ArrowRight, Download } from "lucide-astro";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { KOMPITU_IMAGES } from "../data/kompitu";

const entries = (await getCollection("education")).filter((entry) => entry.data.status === "published");
const module = (id: string) => entries.find((entry) => entry.id === id);
const catalogPlants = [
  { name: "Kunyit (Turmeric)", category: "Obat-obatan", text: "Dikenal dalam pengobatan tradisional dan masakan lokal.", photo: KOMPITU_IMAGES.turmeric },
  { name: "Lidah Buaya (Aloe Vera)", category: "Perawatan kulit", text: "Sukulen serbaguna untuk perawatan sederhana di rumah.", photo: KOMPITU_IMAGES.aloe },
  { name: "Serai (Lemongrass)", category: "Kuliner", text: "Bumbu dapur sekaligus tanaman yang membantu mengusir serangga.", photo: KOMPITU_IMAGES.lemongrass },
];
---

<BaseLayout title="Kompitu: Ruang Belajar Hijau" description="Portal khusus Kompitu RW 3 tentang tanaman, lele cendol, kompos, dan praktik lingkungan warga.">
  <div data-kompitu-page>
  <section class="bg-[#f7f4ee] px-4 py-16 sm:py-20 md:px-12 md:py-20">
    <div class="container-shell grid items-center gap-12 md:grid-cols-2 md:gap-16">
      <div class="relative z-10">
        <p class="eyebrow">Portal khusus Kompitu</p>
        <h1 class="mt-5 max-w-2xl font-display text-5xl font-bold leading-[1.03] text-rw-forest sm:text-6xl">Kompitu:<br />Ruang Belajar<br />Hijau RW 3 Kotabaru</h1>
        <p class="mt-6 max-w-lg text-base leading-8 text-rw-muted sm:text-lg">Merawat warisan dan alam kami. Temukan praktik berkelanjutan, kearifan botani lokal, dan kemajuan ekologis berbasis komunitas yang berakar pada sejarah Kotabaru.</p>
      </div>
      <div class="relative mx-auto h-[25rem] w-full max-w-[32rem] overflow-hidden rounded-[48%_52%_54%_46%/38%_40%_60%_62%] border-4 border-[#e9dab4]/60 bg-rw-mint shadow-[0_20px_50px_rgba(27,67,50,0.14)] sm:h-[34rem]">
        <div class="absolute inset-0 z-10 bg-rw-forest/15 mix-blend-multiply"></div>
        <img src={KOMPITU_IMAGES.hero} alt="Kebun komunitas Kompitu dengan tanaman dalam petak kayu" class="h-full w-full object-cover" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="bg-[#f5f1ea] px-4 py-16 sm:py-20 md:px-12 md:py-20">
    <div class="container-shell grid items-center gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <div class="overflow-hidden rounded-3xl shadow-lg"><img src={KOMPITU_IMAGES.lele} alt="Kolam budidaya Lele Cendol di area Kompitu" class="aspect-[4/3] h-full w-full object-cover" loading="lazy" /></div>
        <p class="mt-3 text-xs italic text-rw-muted/70">Budidaya Lele Cendol di area Kompitu</p>
      </div>
      <div class="flex flex-col justify-center">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-rw-forest/70">Ekosistem Kompitu</p>
        <h2 class="mt-3 font-display text-4xl leading-tight text-rw-forest sm:text-5xl">Budidaya Lele Cendol</h2>
        <p class="mt-5 max-w-xl text-base leading-8 text-rw-muted">Budidaya lele yang dikembangkan bersama warga sebagai bagian dari pemanfaatan ruang Kompitu dan kegiatan pemberdayaan lokal.</p>
      </div>
    </div>
  </section>

  <section class="bg-[#f7f4ee] px-4 py-16 sm:py-20 md:px-12 md:py-20">
    <div class="container-shell">
      <div class="mb-10 text-center"><h2 class="font-display text-3xl text-rw-forest sm:text-4xl">Katalog Tanaman Lokal</h2><p class="mx-auto mt-2 max-w-2xl text-sm leading-7 text-rw-muted">Jelajahi tanaman herbal, tanaman obat, dan tanaman pendukung yang dibudidayakan di kebun komunitas kami.</p></div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {catalogPlants.map((plant) => <a href={`/edukasi/katalog-tanaman?tanaman=${plant.name.toLowerCase().replaceAll(" ", "-")}`} class="group flex h-full flex-col overflow-hidden rounded-xl border border-rw-forest/10 bg-white shadow-sm transition duration-300 hover:-translate-y-1">
          <div class="relative h-48 overflow-hidden"><img src={plant.photo} alt={plant.name} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" /><span class="absolute left-4 top-4 rounded-full bg-rw-terracotta px-3 py-1 text-[11px] font-bold text-white">{plant.category}</span></div>
          <div class="flex flex-1 flex-col p-6"><h3 class="font-display text-2xl text-rw-forest">{plant.name}</h3><p class="mt-3 flex-1 text-sm leading-6 text-rw-muted">{plant.text}</p></div>
        </a>)}
      </div>
      <div class="mt-8 text-center"><a href="/edukasi/katalog-tanaman" class="inline-flex items-center gap-2 text-sm font-bold text-rw-forest transition hover:text-rw-terracotta-dark">Lihat katalog lengkap <ArrowRight size={17} aria-hidden="true" /></a></div>
    </div>
  </section>

  <section id="materi" data-practical-guide class="bg-[#f5f1ea] px-4 py-16 sm:py-20 md:px-12 md:py-20">
    <div class="container-shell">
      <div data-practical-reveal="header" class="mb-8 flex flex-col gap-6 md:mb-10 md:flex-row md:items-end md:justify-between md:gap-8"><div class="max-w-3xl"><p class="eyebrow">PANDUAN PRAKTIS KOMPITU</p><h2 class="mt-4 font-display text-4xl leading-tight text-rw-forest lg:text-5xl">Modul Edukasi Lingkungan</h2><p class="mt-4 max-w-2xl text-sm leading-7 text-rw-muted sm:text-base">Panduan praktis untuk mengelola lingkungan secara berkelanjutan, mulai dari pengolahan kompos hingga sistem penyiraman hemat air.</p></div><a href="/Modul_Final.pdf" download="Modul_Final.pdf" class="inline-flex min-h-12 w-full shrink-0 items-center justify-center gap-2 rounded-full bg-rw-forest px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-rw-green md:w-fit"><Download size={17} aria-hidden="true" />Unduh Semua Modul</a></div>
      <div data-practical-reveal="cards" class="grid gap-5 md:grid-cols-10">
        {module("kompos") && <a href="/edukasi/kompos" class="group relative min-h-[30rem] overflow-hidden rounded-3xl border border-rw-forest/20 shadow-sm transition duration-300 hover:-translate-y-1 md:col-span-6">
          <img src={KOMPITU_IMAGES.komposMix} alt="Pembuatan kompos di Kompitu" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" /><div class="absolute inset-0 bg-gradient-to-t from-rw-forest/95 via-rw-forest/25 to-transparent"></div><div class="absolute bottom-0 left-0 w-full p-7 sm:p-8"><span class="inline-block rounded-full bg-rw-forest px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[#e9dab4]">Modul 01</span><h3 class="mt-3 font-display text-3xl text-white">{module("kompos")?.data.title}</h3><p class="mt-2 max-w-md text-sm leading-6 text-white/90">{module("kompos")?.data.excerpt}</p><span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-[#e9dab4]">Baca panduan <ArrowRight size={16} aria-hidden="true" /></span></div>
        </a>}
        <div class="flex flex-col gap-5 md:col-span-4">
          {module("pestisida-nabati") && <a href="/edukasi/pestisida-nabati" class="group flex min-h-[15rem] overflow-hidden rounded-3xl border border-rw-forest/10 bg-white shadow-sm transition duration-300 hover:-translate-y-1"><div class="flex w-[68%] flex-col justify-center p-6"><span class="mb-3 inline-block w-fit rounded-full bg-rw-forest px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[#e9dab4]">Modul 02</span><h3 class="font-display text-2xl text-rw-forest">{module("pestisida-nabati")?.data.title}</h3><p class="mt-2 line-clamp-3 text-sm leading-6 text-rw-muted">{module("pestisida-nabati")?.data.excerpt}</p><span class="mt-3 inline-flex items-center gap-2 text-sm font-bold text-rw-terracotta-dark">Baca panduan <ArrowRight size={15} aria-hidden="true" /></span></div><div class="w-[32%] overflow-hidden"><img src={KOMPITU_IMAGES.pesticideTest} alt="Pengujian dan penyemprotan larutan pestisida nabati" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" /></div></a>}
          {module("irigasi-tetes") && <a href="/edukasi/irigasi-tetes" class="group relative min-h-[15rem] overflow-hidden rounded-3xl border border-rw-forest/20 shadow-sm transition duration-300 hover:-translate-y-1"><img src={KOMPITU_IMAGES.irrigationFlush} alt="Pemasangan dan pembilasan sistem irigasi tetes di kebun Kompitu" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" /><div class="absolute inset-0 bg-gradient-to-t from-rw-forest/95 via-transparent to-transparent"></div><div class="absolute inset-x-0 bottom-0 p-6"><span class="inline-block rounded-full bg-rw-forest px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[#e9dab4]">Modul 03</span><h3 class="mt-3 font-display text-2xl text-white">{module("irigasi-tetes")?.data.title}</h3><p class="mt-2 text-sm leading-6 text-white/90">{module("irigasi-tetes")?.data.excerpt}</p><span class="mt-3 inline-flex items-center gap-2 text-sm font-bold text-[#e9dab4]">Baca panduan <ArrowRight size={15} aria-hidden="true" /></span></div></a>}
        </div>
        {module("pencacah-daun") && <a href="/edukasi/pencacah-daun" class="group flex min-h-[15rem] overflow-hidden rounded-3xl border border-rw-forest/10 bg-white shadow-sm transition duration-300 hover:-translate-y-1 md:col-span-10"><div class="flex w-full flex-col justify-center p-7 sm:w-3/5 sm:p-8"><span class="mb-3 inline-block w-fit rounded-full bg-rw-forest px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[#e9dab4]">Modul 04</span><h3 class="font-display text-2xl text-rw-forest">{module("pencacah-daun")?.data.title}</h3><p class="mt-2 max-w-xl text-sm leading-6 text-rw-muted">{module("pencacah-daun")?.data.excerpt}</p><span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-rw-terracotta-dark">Baca panduan <ArrowRight size={15} aria-hidden="true" /></span></div><div class="relative hidden w-2/5 overflow-hidden sm:block"><img src={KOMPITU_IMAGES.shredderFeeding} alt="Penggunaan pencacah bahan organik di Kompitu" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" /></div></a>}
      </div>
    </div>
  </section>
  </div>

</BaseLayout>

<script>
  const kompituPage = document.querySelector<HTMLElement>("[data-kompitu-page]");
  const revealTargets = [...(kompituPage?.querySelectorAll<HTMLElement>(":scope > section") ?? [])];
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (kompituPage && revealTargets.length) {
    kompituPage.classList.add("kompitu-reveal-enabled");
    const reveal = (element: HTMLElement) => element.classList.add("is-visible");

    if (reducedMotion || !("IntersectionObserver" in window)) {
      revealTargets.forEach(reveal);
    } else {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            reveal(entry.target as HTMLElement);
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: "0px 0px -10% 0px" });

      revealTargets.forEach((target) => revealObserver.observe(target));
    }
  }
</script>

<style>
  .kompitu-reveal-enabled > section > * {
    opacity: 0;
    transform: translate3d(0, 1.5rem, 0);
    transition: opacity 700ms ease, transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .kompitu-reveal-enabled > section.is-visible > * {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .kompitu-reveal-enabled > section[data-practical-guide] [data-practical-reveal] {
    opacity: 0;
    transform: translate3d(0, 1.25rem, 0);
    transition: opacity 620ms ease, transform 680ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .kompitu-reveal-enabled > section[data-practical-guide].is-visible [data-practical-reveal] {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .kompitu-reveal-enabled > section[data-practical-guide].is-visible [data-practical-reveal="header"] {
    transition-delay: 140ms;
  }

  .kompitu-reveal-enabled > section[data-practical-guide].is-visible [data-practical-reveal="cards"] {
    transition-delay: 300ms;
  }

  .kompitu-reveal-enabled > section[data-practical-guide] [data-practical-reveal="cards"] > * {
    opacity: 0;
    transform: translate3d(0, 1rem, 0);
    transition: opacity 560ms ease, transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .kompitu-reveal-enabled > section[data-practical-guide].is-visible [data-practical-reveal="cards"] > * {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .kompitu-reveal-enabled > section[data-practical-guide].is-visible [data-practical-reveal="cards"] > *:nth-child(1) { transition-delay: 420ms; }
  .kompitu-reveal-enabled > section[data-practical-guide].is-visible [data-practical-reveal="cards"] > *:nth-child(2) { transition-delay: 500ms; }
  .kompitu-reveal-enabled > section[data-practical-guide].is-visible [data-practical-reveal="cards"] > *:nth-child(3) { transition-delay: 580ms; }

  .kompitu-reveal-enabled > section[data-practical-guide] [data-practical-reveal="cards"] > div > a {
    opacity: 0;
    transform: translate3d(0, 1rem, 0);
    transition: opacity 560ms ease, transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .kompitu-reveal-enabled > section[data-practical-guide].is-visible [data-practical-reveal="cards"] > div > a {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .kompitu-reveal-enabled > section[data-practical-guide].is-visible [data-practical-reveal="cards"] > div > a:nth-child(1) { transition-delay: 500ms; }
  .kompitu-reveal-enabled > section[data-practical-guide].is-visible [data-practical-reveal="cards"] > div > a:nth-child(2) { transition-delay: 580ms; }

  @media (prefers-reduced-motion: reduce) {
    .kompitu-reveal-enabled > section > *,
    .kompitu-reveal-enabled > section[data-practical-guide] [data-practical-reveal],
    .kompitu-reveal-enabled > section[data-practical-guide] [data-practical-reveal="cards"] > *,
    .kompitu-reveal-enabled > section[data-practical-guide] [data-practical-reveal="cards"] > div > a {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
