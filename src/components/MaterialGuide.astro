<script>
  const materialGuide = document.querySelector<HTMLElement>("[data-material-guide]");
  const guideSections = [...(materialGuide?.querySelectorAll<HTMLElement>("[data-guide-section]") ?? [])];
  const guideSteps = [...(materialGuide?.querySelectorAll<HTMLElement>("[data-guide-step]") ?? [])];
  const guideLinks = [...(materialGuide?.querySelectorAll<HTMLAnchorElement>("[data-guide-link]") ?? [])];
  const materialRevealTargets = [...(materialGuide?.querySelectorAll<HTMLElement>("[data-guide-section], [data-material-extra]") ?? [])];
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const accordions = [...(materialGuide?.querySelectorAll<HTMLDetailsElement>("[data-accordion]") ?? [])];
  if (accordions.length) {
    materialGuide?.classList.add("accordion-enhanced");

    accordions.forEach((details) => {
      const summary = details.querySelector<HTMLElement>("summary");
      const panel = details.querySelector<HTMLElement>("[data-accordion-panel]");
      if (!summary || !panel) return;

      details.dataset.accordionState = details.open ? "open" : "closed";

      summary.addEventListener("click", (event) => {
        event.preventDefault();
        if (details.dataset.accordionAnimating === "true") return;

        if (reducedMotion) {
          details.open = !details.open;
          details.dataset.accordionState = details.open ? "open" : "closed";
          return;
        }

        if (!details.open) {
          details.open = true;
          details.dataset.accordionState = "closed";
          void panel.offsetHeight;
          window.requestAnimationFrame(() => {
            details.dataset.accordionState = "open";
          });
          return;
        }

        details.dataset.accordionAnimating = "true";
        details.dataset.accordionState = "closing";

        let closed = false;
        const finishClose = () => {
          if (closed) return;
          closed = true;
          details.open = false;
          details.dataset.accordionState = "closed";
          details.dataset.accordionAnimating = "false";
          panel.removeEventListener("transitionend", handleTransitionEnd);
        };
        const handleTransitionEnd = (transitionEvent: TransitionEvent) => {
          if (transitionEvent.propertyName === "grid-template-rows") finishClose();
        };

        panel.addEventListener("transitionend", handleTransitionEnd);
        window.setTimeout(finishClose, 700);
      });
    });
  }

  if (materialGuide && materialRevealTargets.length) {
    materialRevealTargets.forEach((target, index) => target.style.setProperty("--material-reveal-delay", `${Math.min(index * 60, 180)}ms`));
    materialGuide.classList.add("material-reveal-enabled");
    const revealMaterial = (target: HTMLElement) => target.classList.add("material-revealed");

    if (reducedMotion || !("IntersectionObserver" in window)) {
      materialRevealTargets.forEach(revealMaterial);
    } else {
      const materialRevealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            revealMaterial(entry.target as HTMLElement);
            materialRevealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -10% 0px" });

      materialRevealTargets.forEach((target) => materialRevealObserver.observe(target));
    }
  }

  if (guideSections.length && guideSteps.length) {
    const setActiveStep = (activeIndex: number) => {
      guideSteps.forEach((step, index) => step.dataset.active = String(index === activeIndex));
      guideLinks.forEach((link, index) => {
        if (index === activeIndex) link.setAttribute("aria-current", "step");
        else link.removeAttribute("aria-current");
      });
    };

    let framePending = false;
    const updateActiveStep = () => {
      framePending = false;
      const triggerY = window.innerHeight * 0.35;
      let activeIndex = 0;
      guideSections.forEach((section, index) => {
        if (section.getBoundingClientRect().top <= triggerY) activeIndex = index;
      });
      setActiveStep(activeIndex);
    };
    const requestUpdate = () => {
      if (framePending) return;
      framePending = true;
      window.requestAnimationFrame(updateActiveStep);
    };

    guideLinks.forEach((link, index) => link.addEventListener("click", () => setActiveStep(index)));
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    updateActiveStep();
  }
</script>

<style>
  .material-reveal-enabled [data-guide-section] {
    opacity: 0;
    transform: translate3d(0, 0.9rem, 0);
    transition: opacity 480ms ease, transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--material-reveal-delay, 0ms);
  }

  .material-reveal-enabled [data-guide-section].material-revealed {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  [data-guide-step] {
    transition: background-color 240ms ease, border-color 240ms ease, color 240ms ease;
  }

  [data-guide-step][data-active="true"] {
    border-color: var(--color-rw-forest);
    background-color: var(--color-rw-forest);
    color: white;
  }

  /* Animate the native details panel without changing the card's visual language. */
  details.material-problem > .material-problem-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 500ms cubic-bezier(0.22, 1, 0.36, 1), opacity 260ms ease;
  }

  details.material-problem[open] > .material-problem-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* The enhanced state keeps the panel open long enough to animate its closing. */
  [data-material-guide].accordion-enhanced details.material-problem > .material-problem-panel {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  [data-material-guide].accordion-enhanced details.material-problem[data-accordion-state="open"] > .material-problem-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  [data-material-guide].accordion-enhanced details.material-problem[data-accordion-state="open"] summary > span {
    transform: rotate(45deg);
  }

  [data-material-guide].accordion-enhanced details.material-problem[data-accordion-state="closing"] summary > span {
    transform: rotate(0deg);
  }

  .material-problem-panel__inner {
    min-height: 0;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    /* Trim the left edge of the maturity photo to the requested alignment. */
    [data-material-guide] #step4 > div > div:first-child {
      padding-left: 3rem;
      background-color: white;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .material-reveal-enabled [data-guide-section] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    details.material-problem > .material-problem-panel {
      transition: none;
    }

    [data-material-guide].accordion-enhanced details.material-problem[data-accordion-state="open"] > .material-problem-panel {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }

</style>
