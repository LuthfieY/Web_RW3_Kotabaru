---
import { ArrowLeft, Clock3, Leaf, Signal } from "lucide-astro";
import type { CollectionEntry } from "astro:content";
import { KOMPITU_IMAGES, MATERIAL_IMAGES } from "../data/kompitu";
import GuideStepCard from "./GuideStepCard.astro";

interface Props {
  entry: CollectionEntry<"education">;
}

type MaterialStep = {
  id: string;
  title: string;
  description: string;
  photo?: string;
  alt?: string;
  layout?: "image" | "split" | "text";
  reverse?: boolean;
  tips?: string;
  attention?: string;
  good?: string[];
  avoid?: string[];
  checklist?: string[];
  diagram?: boolean;
  blocks?: {
    title: string;
    text?: string;
    items?: string[];
    tone?: "default" | "avoid" | "tip";
  }[];
};

const { entry } = Astro.props;
const images = MATERIAL_IMAGES[entry.id as keyof typeof MATERIAL_IMAGES] ?? [KOMPITU_IMAGES.hero];
const imageAt = (index: number) => images[index] ?? KOMPITU_IMAGES.hero;
const komposProblems = [
  { title: "Bau busuk atau menyengat", cause: "Terlalu basah, terlalu banyak bahan hijau, atau kurang udara.", fix: "Aduk campuran, tambahkan daun kering, dan longgarkan tumpukan." },
  { title: "Tidak terjadi perubahan", cause: "Bahan terlalu kering, terlalu kasar, atau campuran tidak seimbang.", fix: "Tambahkan sedikit air, cacah sebagian bahan, dan tambahkan bahan hijau secukupnya." },
  { title: "Banyak lalat atau hama", cause: "Sisa makanan terbuka atau campuran terlalu basah.", fix: "Tutup permukaan dengan daun kering, hindari bahan berminyak atau daging, dan bersihkan area sekitar." },
  { title: "Terlalu panas atau berasap", cause: "Tumpukan terlalu besar, padat, atau reaksinya sangat aktif.", fix: "Aduk dan bagi tumpukan menjadi bagian yang lebih kecil. Jangan menyiram secara berlebihan." },
  { title: "Kompos menggumpal", cause: "Bahan dicacah terlalu halus dan tumpukan terlalu padat.", fix: "Tambahkan bahan berstruktur seperti daun kering atau ranting kecil." },
];
const pesticideProblems = [
  { title: "Hama masih banyak", cause: "Formula kurang sesuai, semprotan tidak mengenai sasaran, atau serangan sudah berat.", fix: "Identifikasi ulang, perbaiki sanitasi, dan jangan langsung memperpekat larutan. Mintalah pendampingan apabila serangannya berat." },
  { title: "Daun rusak setelah aplikasi", cause: "Larutan terlalu pekat, tanaman sensitif, atau aplikasi dilakukan saat cuaca panas.", fix: "Hentikan penggunaan, bilas bila memungkinkan, catat formula, encerkan, dan lakukan uji ulang pada bagian kecil." },
  { title: "Larutan cepat rusak", cause: "Wadah atau peralatan kotor dan penyimpanan terlalu panas.", fix: "Buang larutan, bersihkan alat, buat batch lebih kecil, dan gunakan segera." },
  { title: "Terjadi iritasi kulit atau mata", cause: "Kontak dengan cabai atau ekstrak pekat.", fix: "Hentikan pekerjaan dan bilas dengan banyak air. Cari bantuan medis apabila keluhan menetap atau berat." },
];
const pesticideSafety = [
  "Gunakan sarung tangan serta pelindung mata dan masker bila bahan mudah terciprat atau berdebu.",
  "Jangan makan, minum, merokok, atau menyentuh wajah selama pembuatan dan aplikasi.",
  "Cuci tangan, alat, serta pakaian kerja setelah selesai.",
  "Jangan membuang larutan pekat ke selokan, kolam, atau sumber air.",
  "Jangan mencampur pestisida nabati dengan pestisida kimia atau produk lain tanpa petunjuk yang jelas.",
];
const materialSteps: Record<string, MaterialStep[]> = {
  kompos: [
    { id: "step1", title: "Pilah dan Cacah Bahan", description: "Pisahkan bahan organik yang dapat dikomposkan dari plastik, logam, kaca, dan bahan lain yang dapat mencemari kompos. Cacah daun, rumput, dan sisa sayur menjadi ukuran sedang agar lebih mudah tercampur dan terurai.", photo: imageAt(0), alt: "Pemilahan bahan organik untuk kompos", blocks: [{ title: "Bahan cokelat - kaya karbon", items: ["Daun kering", "Ranting kecil yang telah dicacah", "Kertas atau karton polos dalam jumlah terbatas", "Sekam atau bahan kering lainnya"] }, { title: "Bahan hijau - kaya nitrogen", items: ["Rumput segar dalam jumlah tipis", "Sisa sayur dan buah", "Ampas kopi atau teh tanpa plastik", "Tanaman kebun yang sehat"] }, { title: "Hindari", tone: "avoid", items: ["Plastik, kaca, dan logam", "Baterai atau bahan kimia", "Tanaman yang terserang penyakit berat", "Kotoran hewan peliharaan", "Daging dan minyak", "Bahan yang terkena pestisida atau herbisida yang tidak diketahui"] }], tips: "Jangan mencacah bahan terlalu halus karena dapat membuat tumpukan menjadi padat dan mengurangi ruang udara." },
    { id: "step2", title: "Siapkan Wadah dan Peralatan", description: "Gunakan karung berpori, keranjang kompos, atau wadah yang memiliki lubang udara dan drainase. Letakkan wadah di tempat teduh, tidak tergenang, dan terlindung dari hujan langsung.", photo: imageAt(1), alt: "Wadah kompos di kebun warga", layout: "split", blocks: [{ title: "Peralatan yang disiapkan", items: ["Karung, keranjang, atau wadah berpori", "Baskom atau ember untuk mencampur bahan", "Gunting atau alat pencacah", "Sekop kecil", "Sarung tangan", "Masker apabila bahan berdebu", "Terpal atau alas kerja", "Alat pengukur suhu apabila tersedia"] }], tips: "Jangan menutup wadah terlalu rapat tanpa ventilasi. Pengomposan aerobik membutuhkan oksigen." },
    { id: "step3", title: "Campurkan Bahan Kompos", description: "Campurkan sekitar 2-3 bagian bahan cokelat dengan 1 bagian bahan hijau sebagai komposisi awal. Sesuaikan campuran berdasarkan kelembapan dan bau, lalu masukkan ke wadah berpori tanpa memadatkannya secara berlebihan.", photo: imageAt(2), alt: "Bahan organik dalam proses pengomposan", layout: "split", blocks: [{ title: "Contoh perbandingan", items: ["2 ember daun kering dan 1 ember rumput segar atau sisa sayur", "3 ember daun kering dan 1 ember bahan hijau"] }, { title: "Perlukah menggunakan aktivator?", text: "Aktivator bukan syarat mutlak. Segenggam kompos matang atau sedikit tanah kebun dapat digunakan sebagai sumber mikroorganisme. EM4 dapat digunakan sesuai petunjuk pada kemasan.", tone: "tip" }], tips: "Hindari menggunakan nasi basi atau nasi aking secara berlebihan karena dapat mengundang hama dan menimbulkan bau." },
    { id: "step4", title: "Atur Kelembapan dan Rawat", description: "Tambahkan air sedikit demi sedikit sambil mengaduk campuran. Jangan menuangkan air terlalu banyak sekaligus. Setelah kelembapan sesuai, aduk atau balik tumpukan minimal satu kali setiap minggu.", photo: imageAt(3), alt: "Pengadukan bahan kompos untuk menjaga kelembapan", layout: "split", blocks: [{ title: "Lakukan uji genggam", items: ["Ambil segenggam campuran kompos", "Remas dengan tangan yang memakai sarung tangan", "Campuran harus terasa lembap", "Air tidak boleh menetes deras"] }], tips: "Terlalu basah atau berbau: tambahkan daun kering dan aduk. Terlalu kering: tambahkan air sedikit demi sedikit. Terlalu padat: longgarkan dan tambahkan ranting kecil." },
    { id: "step5", title: "Pantau Proses Pengomposan", description: "Periksa kompos minimal satu kali setiap minggu. Amati perubahan warna, suhu, aroma, tekstur, dan kelembapannya.", photo: imageAt(4), alt: "Pemantauan proses pengomposan di wadah kompos", layout: "split", blocks: [{ title: "Tahap awal", text: "Bahan mulai mengalami penguraian dan suhu dapat meningkat. Pastikan campuran tetap lembap dan memiliki cukup ruang udara." }, { title: "Tahap aktif", text: "Tumpukan dapat terasa hangat dan penguraian berlangsung lebih cepat. Aduk apabila kompos terlalu panas, berbau, atau mulai memadat." }, { title: "Tahap pendinginan", text: "Suhu mulai menurun dan warna bahan menjadi lebih gelap. Kurangi penambahan bahan baru dan lanjutkan pembalikan ringan." }, { title: "Tahap pematangan", text: "Kompos mulai beraroma tanah, bertekstur remah, dan bentuk bahan awal semakin sulit dikenali.", tone: "tip" }], tips: "Kompos dalam karung atau wadah kecil mungkin tidak mencapai suhu tinggi. Hindari tanaman berpenyakit berat, biji gulma matang, kotoran, atau bahan yang memerlukan sanitasi khusus." },
    { id: "step6", title: "Periksa Kematangan dan Gunakan", description: "Lanjutkan proses pematangan sampai kompos menunjukkan ciri matang dan aman digunakan pada media tanam.", photo: imageAt(5), alt: "Kompos matang siap digunakan", layout: "split", reverse: true, blocks: [{ title: "Ciri kompos matang", items: ["Bahan awal sulit dikenali", "Berwarna gelap", "Suhunya mendekati suhu lingkungan", "Beraroma seperti tanah", "Tidak lagi panas atau berbau busuk", "Teksturnya remah dan tidak menggumpal"] }, { title: "Cara menggunakan kompos matang", items: ["Campurkan dengan tanah atau media tanam", "Gunakan sebagai bagian campuran media pot", "Taburkan sebagai lapisan tipis di permukaan media tanam", "Simpan di tempat teduh, tidak tergenang, dan memiliki sirkulasi udara"], tone: "tip" }], checklist: ["Jangan gunakan kompos yang masih panas atau berbau busuk"] },
  ],
  "pestisida-nabati": [
    { id: "step1", title: "Kenali Hama Sasaran", description: "Amati tanaman dan catat jenis hama atau gejala, bagian tanaman yang terdampak, serta tingkat serangannya sebelum memilih larutan.", photo: imageAt(0), alt: "Pengamatan hama sasaran pada tanaman", blocks: [{ title: "Yang dapat dilakukan", items: ["Dahulukan sanitasi kebun", "Pangkas bagian yang terserang bila perlu", "Perhatikan keberadaan musuh alami", "Catat kondisi awal tanaman", "Ambil foto pembanding bila memungkinkan"] }, { title: "Hindari", tone: "avoid", items: ["Menyemprot tanpa sasaran yang jelas", "Menganggap semua kerusakan disebabkan hama", "Mengabaikan musuh alami", "Menganggap larutan nabati selalu aman", "Menambah kepekatan tanpa pengujian"] }], attention: "Pisahkan tanaman yang menunjukkan gejala berat. Jika penyebab kerusakan tidak jelas atau serangannya berat, mintalah pendampingan penyuluh atau petugas tanaman. Jangan langsung memperpekat larutan." },
    { id: "step2", title: "Siapkan Alat dan Label", description: "Gunakan peralatan bersih yang dikhususkan untuk bahan pertanian. Jangan menggunakan wadah makanan atau minuman untuk membuat dan menyimpan larutan pestisida nabati.", photo: imageAt(1), alt: "Peralatan untuk membuat larutan pestisida nabati", layout: "split", blocks: [{ title: "Peralatan", items: ["Ember atau baskom", "Pisau", "Blender atau ulekan khusus", "Saringan halus", "Sendok pengaduk", "Gelas ukur", "Corong", "Botol semprot", "Sarung tangan", "Pelindung mata dan masker bila diperlukan"] }, { title: "Informasi pada label", items: ["Nama formula", "Bahan yang digunakan", "Tanggal pembuatan", "Nama pembuat", "Sasaran penggunaan", "PESTISIDA NABATI - BUKAN UNTUK DIMINUM"] }], attention: "Simpan alat dan larutan jauh dari anak-anak, hewan peliharaan, makanan, minuman, benih, dan sumber air bersih." },
    { id: "step3", title: "Buat Larutan Kulit Bawang", description: "Masukkan 2 genggam kulit bawang merah bersih ke dalam wadah, kemudian tambahkan 1 liter air bersih. Tutup wadah secara longgar dan rendam selama 24-48 jam di tempat teduh. Saring menggunakan kain atau saringan halus, lalu masukkan ke botol semprot berlabel.", photo: imageAt(2), alt: "Pembuatan larutan kulit bawang", layout: "split", tips: "Gunakan kulit bawang yang bersih, tidak berjamur, dan tidak tercampur plastik atau bahan lain. Buat dalam jumlah secukupnya dan gunakan sesegera mungkin." },
    { id: "step4", title: "Siapkan Formula Kombinasi", description: "Cuci seluruh bahan hingga bersih. Potong menjadi ukuran kecil, haluskan menggunakan alat khusus, lalu masukkan ke wadah bersama 1 liter air. Rendam selama 24-48 jam di tempat teduh, saring bila diperlukan, dan catat tanggal pembuatannya.", photo: imageAt(3), alt: "Persiapan formula kombinasi pestisida nabati", layout: "split", blocks: [{ title: "Bahan tanaman untuk formula awal", items: ["1 genggam bawang putih", "2-3 batang serai", "10 lembar daun pepaya", "Cabai sesuai takaran yang telah diuji dan disepakati", "1 liter air bersih"] }], attention: "Takaran cabai harus diisi berdasarkan formula yang benar-benar telah dipraktikkan dan diuji. Jangan membuat larutan terlalu pekat atau menambahkan bahan lain tanpa uji keamanan tanaman." },
    { id: "step5", title: "Uji dan Semprot", description: "Sebelum digunakan secara luas, semprotkan larutan pada 2-3 daun atau 1 tanaman terlebih dahulu. Tunggu selama 24-48 jam dan periksa apakah muncul bercak, daun terbakar, layu, keriting, atau perubahan warna.", photo: imageAt(4), alt: "Pengujian dan penyemprotan larutan pestisida nabati", layout: "split", blocks: [{ title: "Jika tanaman tidak menunjukkan kerusakan", items: ["Kocok larutan sebelum digunakan", "Semprot pada pagi sebelum terik atau sore hari", "Semprot tipis dan merata pada bagian atas serta bawah daun", "Utamakan bagian tanaman yang menunjukkan serangan", "Jangan menyemprot hingga larutan menetes berlebihan", "Hindari hujan, angin kencang, dan saat lebah atau polinator aktif pada bunga"] }, { title: "Hentikan penggunaan apabila", tone: "avoid", items: ["Daun terbakar", "Tanaman layu atau keriting", "Terjadi perubahan warna yang luas", "Kondisi tanaman semakin memburuk"] }], attention: "Catat hasil setelah 24-48 jam. Pengulangan dapat dilakukan sekitar 5-7 hari kemudian hanya jika diperlukan dan tanaman tidak menunjukkan kerusakan. Bila aman dilakukan, bilas daun dengan air bersih dan uji ulang formula pada bagian kecil." },
    { id: "step6", title: "Simpan, Pantau, dan Evaluasi", description: "Larutan berbasis air mudah terkontaminasi dan mengalami perubahan. Sebaiknya buat dalam jumlah kecil dan gunakan pada hari yang sama.", layout: "text", blocks: [{ title: "Apabila harus disimpan", items: ["Gunakan botol yang bersih dan tertutup", "Pastikan botol memiliki label", "Simpan di tempat sejuk dan teduh", "Jauhkan dari anak-anak, makanan, dan sumber air", "Gunakan paling lambat 3-7 hari, hanya jika tidak terjadi perubahan mutu"] }, { title: "Masih dapat digunakan", tone: "tip", items: ["Aromanya masih khas bahan", "Tidak berlendir", "Tidak berjamur", "Tidak terjadi perubahan warna mencolok", "Telah dikocok dan lolos uji terbatas"] }, { title: "Jangan digunakan", tone: "avoid", items: ["Berbau busuk atau menyengat tidak wajar", "Botol menggembung", "Terdapat jamur berlebihan", "Larutan berlendir", "Muncul endapan aneh", "Warna berubah secara mencolok"] }], attention: "Apabila nozel tersumbat, saring ulang larutan. Jangan memperbesar lubang nozel dengan benda tajam ketika botol masih berisi." },
  ],
  "irigasi-tetes": [
    { id: "step1", title: "Kenali Komponen", description: "Siapkan sumber air dan filter, saluran primer, manifold, saluran lateral, emitter, penyangga, dan penutup ujung jaringan.", photo: imageAt(0), alt: "Sistem irigasi tetes di kebun Kompitu", layout: "split", tips: "Rancangan awal menggunakan 20 pot cabai, selang PE 16 mm, satu emitter per pot, dan debit nominal 2 liter per jam." },
    { id: "step2", title: "Pasang dan Bilas Jaringan", description: "Pasang filter, rapikan selang utama, buat cabang menuju pot, dan letakkan emitter 5–10 cm dari pangkal batang. Buka ujung jaringan untuk membilasnya.", photo: imageAt(1), alt: "Pemasangan jaringan irigasi tetes", layout: "split", tips: "Hindari selang tertekuk atau terjepit. Emitter tidak boleh menempel pada batang dan seluruh pot perlu mendapat aliran." },
    { id: "step3", title: "Uji Debit dan Atur Durasi", description: "Tampung air dari beberapa emitter selama 10 menit dan bandingkan volumenya. Mulai dari 15–20 menit saat sejuk, 25–30 menit saat cerah, atau 35–45 menit saat sangat panas.", photo: imageAt(2), alt: "Pengujian tetesan pada tanaman", layout: "split", tips: "Debit aktual dipengaruhi tekanan, panjang selang, ketinggian, dan sumbatan. Sesuaikan durasi dengan kelembapan media dan drainase." },
    { id: "step4", title: "Periksa dan Rawat", description: "Buka keran perlahan, periksa semua emitter, lalu amati kebocoran, pot tergenang, dan media yang terlalu kering selama penggunaan.", photo: imageAt(3), alt: "Pemeriksaan dan perawatan sistem irigasi tetes", layout: "split", reverse: true, checklist: ["Bersihkan filter dan bilas ujung jaringan", "Periksa sambungan dan selang", "Catat waktu, kondisi, dan perubahan durasi"] },
  ],
  "pencacah-daun": [
    { id: "step1", title: "Kenali Fungsi dan Batas Penggunaan", description: "Gunakan alat untuk mencacah bahan organik lunak seperti daun, rumput, sisa sayuran, dan residu tanaman kebun.", photo: imageAt(0), alt: "Bahan organik lunak untuk pencacah daun", blocks: [{ title: "Bahan yang sesuai", items: ["Daun", "Rumput", "Sisa sayuran", "Residu tanaman kebun"] }, { title: "Hindari", tone: "avoid", items: ["Kayu besar", "Tulang", "Batu, kaca, logam, plastik, dan tali", "Tanaman beracun", "Bahan yang busuk atau terkontaminasi"] }] },
    { id: "step2", title: "Siapkan Lokasi, Bahan, dan Operator", description: "Gunakan lantai yang rata, kering, terang, dan memiliki sirkulasi udara. Pastikan kabel tidak melintang dan area kerja bebas dari anak-anak, hewan, serta penonton. Operator harus sehat, fokus, dan telah mendapat arahan. Gunakan pakaian pas badan, sepatu tertutup, kacamata kerja, serta masker apabila bahan berdebu. Siapkan wadah hasil yang stabil, P3K, dan alat kebersihan.", photo: imageAt(1), alt: "Persiapan lokasi dan operator pencacah daun", layout: "split", blocks: [{ title: "Persiapan bahan", items: ["Singkirkan batu, logam, kaca, plastik, dan tali", "Hindari bahan busuk atau terkontaminasi", "Pendekkan bahan yang terlalu panjang", "Tiriskan bahan yang sangat basah", "Siapkan dalam jumlah kecil untuk setiap pemasukan"] }] },
    { id: "step3", title: "Periksa Sebelum Menyalakan", description: "Pastikan alat belum terhubung listrik. Periksa kondisi pelindung, corong, keluaran, kabel, steker, sakelar, baut, rangka, dan area kerja.", layout: "text", attention: "Pastikan tidak terdapat retakan, kabel terkelupas, baut longgar, atau bagian berputar yang terbuka." },
    { id: "step4", title: "Nyalakan dan Masukkan Bahan Bertahap", description: "Hubungkan alat ke sumber listrik yang sesuai dan pastikan tidak ada orang di arah keluaran. Nyalakan alat sesuai urutan pada manual dan dengarkan suara awalnya. Masukkan bahan sedikit demi sedikit. Tunggu bahan pertama tercacah sebelum menambahkan bahan berikutnya. Gunakan pendorong nonlogam yang disetujui produsen apabila diperlukan.", photo: imageAt(3), alt: "Memasukkan bahan ke pencacah daun secara bertahap", layout: "split", tips: "Jangan memasukkan tangan, kaki, besi, atau kayu sembarangan ke dalam corong. Hentikan alat apabila muncul suara, getaran, bau, atau panas yang tidak normal." },
    { id: "step5", title: "Tangani Kemacetan dan Gangguan", description: "Matikan sakelar, cabut steker dengan memegang kepala steker, dan tunggu pisau berhenti total.", layout: "text", attention: "Jangan membuka alat atau mengorek bahan ketika listrik masih terhubung. Ikuti prosedur pada manual dan hubungi teknisi apabila penyebab gangguan tidak dapat ditemukan." },
    { id: "step6", title: "Matikan, Bersihkan, dan Rawat", description: "Hentikan pemasukan bahan dan biarkan ruang cacah kosong. Matikan sakelar, cabut steker, lalu tunggu pisau berhenti sepenuhnya.", photo: imageAt(5), alt: "Membersihkan dan merawat alat pencacah daun", layout: "split", reverse: true, checklist: ["Pindahkan hasil cacahan dan bersihkan sisa bahan menggunakan kuas atau sikat", "Jangan menyemprot motor, sakelar, steker, atau kabel dengan air", "Ikuti manual produsen untuk metode pembersihan bagian dalam"] },
  ],
};
const steps = materialSteps[entry.id] ?? materialSteps.kompos;
const readingDuration = (entry.data.duration ?? "5 menit membaca").replace(/\s*membaca$/i, "");
---

<div data-material-guide class="bg-[#f7f4ee]">
  <section class="px-4 py-16 sm:py-20 md:px-12 md:py-20"><div class="container-shell"><header><a href="/kompitu" class="mb-8 flex w-fit items-center gap-2 text-sm font-bold text-rw-forest transition hover:text-rw-terracotta-dark"><ArrowLeft size={16} aria-hidden="true" />Kembali ke Kompitu</a><p class="eyebrow">Panduan praktis Kompitu</p><h1 class="mt-4 max-w-4xl font-display text-4xl font-bold leading-tight text-rw-forest sm:text-5xl">{entry.id === "kompos" ? "Membuat Biokompos dari Rumah" : entry.data.title}</h1><p class="mt-5 max-w-3xl text-base leading-8 text-rw-muted sm:text-lg">{entry.data.excerpt}</p><div class="mt-6 flex flex-wrap items-center gap-4 text-xs font-semibold text-rw-muted sm:text-sm"><span class="inline-flex items-center gap-2"><Clock3 size={16} class="text-rw-forest" aria-hidden="true" />Durasi membaca: {readingDuration}</span><span class="text-rw-line">|</span><span class="inline-flex items-center gap-2"><Signal size={16} class="text-rw-forest" aria-hidden="true" />Tingkat: Pemula</span><span class="text-rw-line">|</span><span class="inline-flex items-center gap-2"><Leaf size={16} class="text-rw-forest" aria-hidden="true" />Materi Kompitu</span></div></header></div></section>

  <section class="bg-[#f5f1ea] px-4 py-12 sm:py-16 md:px-12 md:py-20"><div class="container-shell grid gap-8 lg:grid-cols-12 lg:gap-10">
    <aside class="h-fit lg:sticky lg:top-24 lg:col-span-3"><div class="rounded-2xl border border-rw-forest/20 bg-white p-5 shadow-[0_4px_20px_rgba(27,67,50,0.06)] sm:p-6"><h2 class="border-b border-rw-line pb-4 font-display text-2xl text-rw-forest">Panduan ringkas</h2><ol class="relative mt-5 space-y-5 before:absolute before:inset-y-0 before:left-3.5 before:w-0.5 before:bg-rw-forest/15">{steps.map((step, index) => <li class="relative pl-11"><span data-guide-step data-active={index === 0 ? "true" : "false"} class="absolute left-0 top-0 grid size-7 place-items-center rounded-full border border-rw-line bg-white text-xs font-bold text-rw-forest">{index + 1}</span><a data-guide-link href={`#${step.id}`} class="text-sm font-semibold text-rw-ink transition hover:text-rw-terracotta-dark">{step.title}</a></li>)}</ol></div></aside>
    <div class="space-y-8 lg:col-span-9">
      {steps.map((step, index) => <GuideStepCard step={step} index={index} />)}
      {entry.id === "kompos" && <>
        <section data-material-extra class="border-t border-rw-line pt-8">
