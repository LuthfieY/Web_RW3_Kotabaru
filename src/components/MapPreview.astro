---
import { ArrowUpRight, Droplets, Landmark, MapPin, Recycle, Sprout, Store, Users } from "lucide-astro";

const points = [
  { label: "Monumen", x: "24%", y: "32%", color: "#b64a3b", icon: Landmark },
  { label: "Kompitu", x: "63%", y: "25%", color: "#6c8f48", icon: Sprout },
  { label: "UMKM", x: "77%", y: "59%", color: "#3d7658", icon: Store },
  { label: "Ibadah", x: "38%", y: "68%", color: "#5a6d91", icon: Users },
  { label: "Sampah", x: "57%", y: "78%", color: "#69736d", icon: Recycle },
  { label: "Fasilitas", x: "82%", y: "27%", color: "#8a6654", icon: Droplets },
];
---

<div class="overflow-hidden rounded-xl border border-rw-line bg-[#dfe9e0] shadow-[0_18px_48px_rgba(27,67,50,0.12)]">
  <div class="flex items-center justify-between border-b border-rw-forest/10 bg-white/80 px-4 py-3">
    <div class="flex items-center gap-2 text-sm font-bold text-rw-forest"><MapPin size={17} class="text-rw-terracotta" aria-hidden="true" />Peta Potensi RW 3</div>
    <span class="text-[0.68rem] font-extrabold uppercase tracking-[0.1em] text-rw-muted">Preview</span>
  </div>
  <div class="relative aspect-[4/3] overflow-hidden bg-[#dbe8dc]" aria-label="Preview ilustratif peta POI RW 3">
    <div class="absolute inset-0 opacity-45" style="background-image: linear-gradient(28deg, transparent 47%, rgba(255,255,255,.8) 48%, rgba(255,255,255,.8) 51%, transparent 52%), linear-gradient(118deg, transparent 48%, rgba(255,255,255,.72) 49%, rgba(255,255,255,.72) 51%, transparent 52%); background-size: 160px 130px, 190px 170px;"></div>
    <div class="absolute left-[8%] top-[12%] h-20 w-48 rotate-12 border-y-2 border-[#b3cbb6]/80"></div>
    <div class="absolute bottom-[14%] right-[9%] h-28 w-56 -rotate-12 border-y-2 border-[#b3cbb6]/80"></div>
    {points.map(({ label, x, y, color, icon: Icon }) => (
      <div class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${x};top:${y}`}>
        <span class="grid size-9 place-items-center rounded-full border-2 border-white shadow-lg" style={`background:${color}`} title={label}><Icon size={15} color="white" aria-hidden="true" /></span>
      </div>
    ))}
    <div class="absolute bottom-4 left-4 rounded-lg bg-white/90 px-3 py-2 text-xs font-semibold text-rw-forest shadow-sm">7 kategori POI siap dijelajahi</div>
  </div>
  <div class="flex flex-col gap-3 bg-white px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="max-w-md text-xs leading-5 text-rw-muted">Gunakan peta untuk menemukan sejarah, ruang hijau, fasilitas, UMKM, dan titik kelola sampah.</p>
    <a href="/peta" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-rw-terracotta px-4 py-2.5 text-sm font-bold text-white transition hover:bg-rw-terracotta-dark">Buka peta <ArrowUpRight size={16} aria-hidden="true" /></a>
  </div>
</div>
