---
import { ArrowUpRight, Clock3, MessageCircle, MapPin, ShieldAlert } from "lucide-astro";
import type { Umkm } from "../data/umkm";

interface Props {
  umkm: Umkm;
}

const { umkm } = Astro.props;
---

<article class="group flex flex-col overflow-hidden rounded-2xl border border-black/5 bg-[#e9dab4]/75 shadow-[0_4px_20px_rgba(27,67,50,0.08)] transition duration-300 hover:-translate-y-1">
  <a href={`/umkm/${umkm.slug}`} class="relative block aspect-[16/9] overflow-hidden bg-rw-mint/30">
    <img src={umkm.photo} alt={umkm.name} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
    <span class="absolute left-3 top-3 rounded-full bg-rw-terracotta px-3 py-1 text-[0.62rem] font-extrabold uppercase tracking-[0.1em] text-white">{umkm.category}</span>
  </a>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-xl font-bold text-rw-forest">{umkm.name}</h3>
      <a href={`/umkm/${umkm.slug}`} aria-label={`Lihat detail ${umkm.name}`} class="text-rw-terracotta transition group-hover:translate-x-0.5"><ArrowUpRight size={18} aria-hidden="true" /></a>
    </div>
    <p class="mt-3 line-clamp-3 flex-1 text-sm leading-6 text-rw-muted">{umkm.description}</p>
    <div class="mt-5 space-y-2 text-xs text-rw-muted">
      {umkm.address ? <p class="flex items-center gap-2"><MapPin size={15} aria-hidden="true" />{umkm.address}</p> : <p class="flex items-center gap-2"><ShieldAlert size={15} aria-hidden="true" />Lokasi menunggu verifikasi</p>}
      {umkm.openingHours ? <p class="flex items-center gap-2"><Clock3 size={15} aria-hidden="true" />{umkm.openingHours}</p> : <p class="flex items-center gap-2"><Clock3 size={15} aria-hidden="true" />Jam buka belum dicatat</p>}
    </div>
    <div class="mt-5 grid grid-cols-2 gap-2">
      <a href={`/umkm/${umkm.slug}`} class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-rw-forest px-2 py-2 text-[0.68rem] font-bold text-white transition hover:bg-rw-green"><ArrowUpRight size={14} aria-hidden="true" />Lihat profil</a>
      {umkm.status === "verified" && umkm.whatsapp && <a href={`https://wa.me/${umkm.whatsapp}`} class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-black/10 bg-white/75 px-2 py-2 text-[0.68rem] font-bold text-rw-forest transition hover:bg-white" target="_blank" rel="noreferrer"><MessageCircle size={14} aria-hidden="true" />Hubungi</a>}
    </div>
  </div>
</article>
