---
type GuideBlock = {
  title: string;
  text?: string;
  items?: string[];
  tone?: "default" | "avoid" | "tip";
};

interface Props {
  blocks: GuideBlock[];
}

const { blocks } = Astro.props;
---

<div class="mt-5 space-y-5">
  {blocks.map((block) => <div class="border-t border-rw-line pt-4 first:border-t-0 first:pt-0">
    <h3 class:list={["text-xs font-bold uppercase tracking-wider", block.tone === "avoid" ? "text-rw-terracotta-dark" : "text-rw-forest"]}>{block.title}</h3>
    {block.text && <p class="mt-2 text-sm leading-6 text-rw-muted">{block.text}</p>}
    {block.items && <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-6 text-rw-muted">{block.items.map((item) => <li>{item}</li>)}</ul>}
  </div>)}
</div>
