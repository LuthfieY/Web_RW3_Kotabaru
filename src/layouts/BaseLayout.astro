---
import "../styles/global.css";
import { SITE } from "../data/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = `${SITE.name} | Sejarah, Warga, dan Lingkungan`,
  description = SITE.description,
  image = "https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=1600&q=82",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const pageTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CivicStructure",
  name: SITE.name,
  description,
  url: SITE.url,
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.city,
    addressCountry: "ID",
  },
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#003d2b" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@400;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23003d2b'/%3E%3Cpath d='M17 43V21h9v14h12V21h9v22H17Z' fill='%23f1e1bb'/%3E%3C/svg%3E" />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
